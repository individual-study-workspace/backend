# docker-compose.prod.yml 용 환경변수 예시.
# EC2 의 compose 디렉터리에 `.env` 로 복사한 뒤 실제 값으로 채운다.
#   cp .env.prod.example .env  &&  vi .env
# .env 는 절대 커밋하지 않는다 (.gitignore 로 차단됨).

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-strong-root
DB_NAME=tutoring
DB_USERNAME=tutoring
DB_PASSWORD=change-me-strong

# --- App (prod 프로필) ---
JWT_SECRET=change-me-at-least-64-chars-long-random-secret-value-here-xxxxx
CORS_ORIGINS=https://your-domain.example

GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
KAKAO_CLIENT_ID=REPLACE_ME
KAKAO_CLIENT_SECRET=REPLACE_ME

# --- App 이미지 (ECR) ---
# 배포 스크립트가 export 하면 생략 가능. 수동 실행 시 채운다.
# ECR_IMAGE=<account>.dkr.ecr.ap-northeast-2.amazonaws.com/classit-server:latest
